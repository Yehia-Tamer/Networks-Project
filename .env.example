# Copy this file to .env and fill in your own values. Never commit .env.

# PostgreSQL: postgresql+psycopg://<user>:<password>@<host>:<port>/<database>
# Use the password you set when installing PostgreSQL, and port 5432 or 5433.
DATABASE_URL=postgresql+psycopg://postgres:your_password@localhost:5432/ChatDB

# Make a new secret with:  python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=replace_me_with_a_64_character_hex_string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRES_MINUTES=1440
